 "tools": {
  "create_proposal_draft": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false,
    "title": "Create proposal draft"
   },
   "input": {
    "properties": {
     "bid_amount": {
      "description": "USD; hourly rate if bid_type=hourly",
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "title": "Bid Amount",
      "type": "number"
     },
     "bid_type": {
      "default": "fixed",
      "enum": [
       "fixed",
       "hourly"
      ],
      "title": "Bid Type",
      "type": "string"
     },
     "cover_letter": {
      "maxLength": 5000,
      "minLength": 50,
      "title": "Cover Letter",
      "type": "string"
     },
     "dry_run": {
      "default": false,
      "description": "Preview only: return the payload and cost, send nothing",
      "title": "Dry Run",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Unique per intended action; retries must reuse it",
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9:_\\-.]+$",
      "title": "Idempotency Key",
      "type": "string"
     },
     "job_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
     },
     "screening_answers": {
      "default": [],
      "items": {
       "maxLength": 2000,
       "type": "string"
      },
      "maxItems": 10,
      "title": "Screening Answers",
      "type": "array"
     }
    },
    "required": [
     "job_id",
     "cover_letter",
     "bid_amount",
     "idempotency_key"
    ],
    "title": "create_proposal_draftArguments",
    "type": "object"
   },
   "output": {
    "additionalProperties": true,
    "properties": {
     "balance_after": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Balance After"
     },
     "balance_before": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Balance Before"
     },
     "connects_cost": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Connects Cost"
     },
     "dry_run": {
      "title": "Dry Run",
      "type": "boolean"
     },
     "message_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Message Id"
     },
     "proposal_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Proposal Id"
     },
     "replayed": {
      "default": false,
      "description": "True when an earlier call with this idempotency_key is returned",
      "title": "Replayed",
      "type": "boolean"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "thread_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Thread Id"
     },
     "would_send": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "dry_run only: the exact payload that would be sent",
      "title": "Would Send"
     }
    },
    "required": [
     "dry_run",
     "status"
    ],
    "title": "WriteResult",
    "type": "object"
   }
  },
