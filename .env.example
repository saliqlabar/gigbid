# Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_SECRET_KEY=change-me-long-random-string
REVIEWER_PASSWORD=change-me
# Fernet key for encrypted OAuth tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Marketplace
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=dev-token
GIGSIM_API_TOKENS=dev-token
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/upwork/callback
UPWORK_CLIENT_METADATA_URL=

# MCP servers (HTTP mode): token=user:freelancer pairs accepted by the servers, and the client token
MCP_BACKEND=inproc
MCP_TOKENS=dev-mcp-token=service:service
MCP_CLIENT_TOKEN=dev-mcp-token
MARKETPLACE_MCP_URL=http://localhost:8091/mcp
PORTFOLIO_MCP_URL=http://localhost:8092/mcp
WORKSPACE_MCP_URL=http://localhost:8093/mcp

# Models: open (local Ollama) | open_hosted (Groq, open-weight models) | test (CI)
MODEL_PROFILE=open
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=

# Tracing (self-hosted Arize Phoenix)
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PUBLIC_URL=

# GitHub MCP server (third-party, for repo ingestion)
GITHUB_PERSONAL_ACCESS_TOKEN=
